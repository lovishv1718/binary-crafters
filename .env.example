DATABASE_URL=file:./binarycrafters.db
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: admin account created by "npm run seed"
SEED_ADMIN_EMAIL=admin@binarycrafters.local
SEED_ADMIN_PASSWORD=change-me

# Optional: email alerts for new enquiries (SMTP from your email provider)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where enquiry alerts go (defaults to the email in Site settings)
LEADS_NOTIFY_TO=
